# =============================================================================
# eng-crew environment configuration
# Copy this file to .env and fill in your values.
#
# Where this file goes:
#   - from a clone of the repo: .env at the repo root (beside eng_crew/)
#   - pip-installed:            ~/.eng-crew/.env, and/or a .env in the
#                               directory you run eng-crew from, which wins
# An installed eng-crew keeps its database, logs and run artifacts under
# ~/.eng-crew and never inside site-packages.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider — choose one:
#   claude_cli   — FREE: uses the Claude Code CLI (no API key needed)
#   gemini_cli   — FREE: uses the Gemini CLI (no API key needed)
#   anthropic    — paid API via Anthropic
#   gemini       — paid API via Google AI Studio
#   openrouter   — paid API via OpenRouter
# -----------------------------------------------------------------------------
ENG_CREW_PROVIDER=claude_cli

# -----------------------------------------------------------------------------
# Claude CLI (FREE) — no API key needed
# Requires Claude Code CLI: https://claude.ai/code
# Install: npm install -g @anthropic-ai/claude-code
# Authenticate: run `claude` once and follow the login prompt.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Gemini CLI (FREE) — no API key needed
# Requires Gemini CLI: https://github.com/google-gemini/gemini-cli
# Install: npm install -g @google/gemini-cli
# Authenticate: run `gemini` once and follow the Google login prompt.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Anthropic API — paid, required when PROVIDER=anthropic
# Get your key at https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# OpenRouter — paid, required when PROVIDER=openrouter
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=

# Google Gemini API — paid, required when PROVIDER=gemini
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Model selection (per provider)
# -----------------------------------------------------------------------------
# Anthropic models: claude-opus-4-7, claude-sonnet-5, claude-haiku-4-5-20251001
ENG_CREW_ARCHITECT_MODEL=claude-sonnet-5
ENG_CREW_CODER_MODEL=claude-sonnet-5
ENG_CREW_REVIEWER_MODEL=claude-sonnet-5

# The independent review of a landed run against its ticket's acceptance
# criteria: one cheap call that must not be able to edit the code it is judging.
# A CLI provider here is run through the Claude CLI with every file and shell
# tool disabled. A reviewer that cannot run at all — no API key, a provider
# error — leaves the ticket in in_review marked "review unavailable", never
# changes_requested.
# ENG_CREW_TICKET_REVIEWER_PROVIDER=claude_cli
ENG_CREW_TICKET_REVIEWER_MODEL=claude-haiku-4-5-20251001
# ENG_CREW_TICKET_REVIEW_ENABLED=true

# OpenRouter model slugs (used when PROVIDER=openrouter)
# e.g. deepseek/deepseek-chat, meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat

# Gemini model (used when PROVIDER=gemini)
# e.g. gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Budget & rate limits
# -----------------------------------------------------------------------------
# Maximum USD spend per single run (0 = unlimited)
ENG_CREW_BUDGET_USD=5.00

# Maximum tokens per LLM call
ENG_CREW_MAX_TOKENS=8192

# Maximum retries per subtask before marking it failed
ENG_CREW_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Ticket queue
# -----------------------------------------------------------------------------
# There are no sprints: tickets form one continuous queue. This is the most
# work allowed in flight per project at once — a ticket cannot move to
# in_progress while this many are already in_progress / in_review / in_qa.
ENG_CREW_WIP_LIMIT=3

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
# Port for the web dashboard
ENG_CREW_DASHBOARD_PORT=9000

# Host to bind the dashboard server (0.0.0.0 for Docker, 127.0.0.1 for local)
ENG_CREW_DASHBOARD_HOST=127.0.0.1

# Secret key for dashboard session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENG_CREW_SECRET_KEY=

# -----------------------------------------------------------------------------
# Pipeline behavior
# -----------------------------------------------------------------------------
# Whether human-in-the-loop approval is required before coding begins (true|false)
ENG_CREW_REQUIRE_APPROVAL=true

# Number of parallel coder agents (1–8)
ENG_CREW_CODER_PARALLELISM=2

# Git branch prefix for ai-team runs
ENG_CREW_BRANCH_PREFIX=ai-team

# -----------------------------------------------------------------------------
# Data & storage
# -----------------------------------------------------------------------------
# Where eng-crew keeps its config and data when nothing else says otherwise.
# Only consulted by an installed eng-crew; a checkout uses its own root.
# ENG_CREW_HOME=~/.eng-crew

# Directory where the database, run artifacts, logs, and checkpoints are stored.
# Relative paths resolve against the repo root in a checkout, else the current
# directory. Leave unset to use ~/.eng-crew (installed) or ./.eng-crew (checkout).
# ENG_CREW_DATA_DIR=.eng-crew

# Maximum run history entries to retain (0 = unlimited)
ENG_CREW_MAX_RUN_HISTORY=100

# -----------------------------------------------------------------------------
# Discord bot (optional)
# -----------------------------------------------------------------------------
# Project aliases for /task and /ideate. Defaults to bot_config.json inside the
# data dir; projects registered on the dashboard are picked up automatically.
# ENG_CREW_BOT_CONFIG=~/.eng-crew/bot_config.json

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
ENG_CREW_LOG_LEVEL=INFO

# Log format: json | console
ENG_CREW_LOG_FORMAT=console

# Turn budget for the single-agent builder. Hitting it cuts the work off
# mid-change and leaves the rest to a repair pass. Test-first builds (tasks with
# acceptance criteria) spend turns on failing tests first, so they get more.
ENG_CREW_BUILDER_MAX_TURNS=60
ENG_CREW_BUILDER_TEST_FIRST_MAX_TURNS=100

# -----------------------------------------------------------------------------
# Entroly context optimizer (optional, off by default)
# An information-theoretic context optimizer. When enabled *and* installed
# (pip install entroly[native]), a run refreshes the project's Entroly index,
# the project context handed to the agents is compressed to the token budget
# below, and agents are offered `entroly` as an MCP server. With it off, or
# with the entroly CLI missing, eng-crew behaves exactly as it does without it
# — it is an optional extra, never a dependency.
# -----------------------------------------------------------------------------
# Turn the integration on (1|true|yes). Default: off.
# ENTROLY_ENABLED=0

# Quality profile handed to entroly. Default: balanced.
# ENTROLY_QUALITY=balanced

# Token budget the project context is compressed to. Default: 8192.
# ENTROLY_TOKEN_BUDGET=8192

# Absolute path to the entroly CLI, when it is not on PATH (e.g. a venv).
# ENTROLY_BIN=
